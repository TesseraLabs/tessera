# /etc/tessera/config.toml.example
#
# Tessera main configuration. Copy this file to
# /etc/tessera/config.toml and edit it for your site before enabling
# tessera.service.
#
# This file is parsed by both libpam_tessera.so (the PAM module) and
# tessera (the daemon). Both must read identical config.
#
# All keys are validated by `tessera_core::config::ValidatedConfig`.
# If a key is missing here that the validator demands, the daemon and the
# PAM module refuse to start. Do not rely on undocumented defaults.

# --- Crypto backend ----------------------------------------------------------
# "openssl"       — chain verification and challenge-response signing
#                   happen via OpenSSL. Required for GOST signatures
#                   provided by gost-engine.
# "pkcs11_native" — verification keys live on the token; OpenSSL is bypassed
#                   for signing. GOST via the token's own provider.
crypto_backend = "pkcs11_native"

# --- Mode --------------------------------------------------------------------
# "pkcs12" : passphrase-protected PKCS#12 file on a USB filesystem.
# "pkcs11" : token-resident keypair via PKCS#11 (Rutoken, JaCarta).
mode = "pkcs11"

# --- PKCS#11 -----------------------------------------------------------------
# Required when mode = "pkcs11"; ignored otherwise.
pkcs11_module = "/usr/lib/librtpkcs11ecp.so"
# Optional CKA_LABEL filter for the token (≤ 64 bytes, no NUL). Omit to use
# the first available token on the bus.
# pkcs11_token_label = "RUTOKEN ECP"
# Optional CKA_LABEL filter for the on-token cert / private-key object.
# Omit to use the first end-entity cert found.
# pkcs11_object_label = "user-cert"
# Maximum number of consecutive PIN attempts before bailing. Range 1..=5.
pkcs11_max_pin_attempts = 3
# The module is loaded and C_Initialize'd once per process and is never
# finalized — C_Finalize would deinitialize PKCS#11 for every other consumer
# sharing the same library in that process (pam_pkcs11, sshd built with
# PKCS11Provider), which has no way of noticing.
# PKCS#11 locking mode. "mutex" (default) serializes every module call
# through a process-global mutex; "os" removes that and lets calls run
# concurrently. A module advertising CKF_OS_LOCKING_OK is not proof that it
# tolerates concurrency — some abort the calling process — so switch to "os"
# only on a module whose vendor confirms thread safety. The mode is fixed by
# the first load of a given module in a process: another PAM stack entry
# asking for the other mode gets the established one and a WARN.
pkcs11_locking_mode = "mutex"
# Localized PIN prompt shown to the user. Defaults to a Russian prompt at
# runtime; uncomment to override.
# pkcs11_pin_prompt = "Введите PIN-код токена: "
# Maximum time wait_for_token will block waiting for the user to insert the
# token, in seconds. Range 0..=60. 0 disables the wait entirely.
pkcs11_slot_wait_seconds = 10
# Accept private keys the token reports as CKA_EXTRACTABLE = TRUE. Default
# false: an extractable key breaks the mode-B invariant (key never leaves the
# token), so authentication fails closed. Set to true only as a deliberate
# operator decision; the violation is then logged as WARN
# pkcs11_extractable_key. This key does NOT cover a token that never reports
# the attribute — that case has its own key below.
# pkcs11_allow_extractable_keys = false
# Accept a private key for which the token did not report CKA_EXTRACTABLE at
# all. Default false: silence is not proof of non-extractability, so
# authentication fails closed. Set to true when the token vendor confirms the
# keys are non-extractable and the module simply withholds the attribute; the
# admission is then logged as WARN pkcs11_extractable_attribute_unavailable
# with the reason the provider gave (sensitive, type_invalid, unavailable,
# available_but_not_returned, probe_failed). This key does NOT accept keys
# that openly report themselves as extractable.
# pkcs11_allow_unreported_extractable = false

# --- PKCS#12 -----------------------------------------------------------------
# Used only when mode = "pkcs12".
#
# Относительный путь к .p12 от точки монтирования USB-носителя.
# Поддерживает плейсхолдер ${user} (имя PAM-пользователя).
# Не должен начинаться с / и не должен содержать сегментов ../ или ./.
# Default: "certs/user.p12".
# pkcs12_path_pattern = "certs/user.p12"
# альтернативные варианты:
# pkcs12_path_pattern = "service.p12"
# pkcs12_path_pattern = "${user}.p12"
# pkcs12_pin_prompt   = "Пароль PKCS#12: "

# --- gost-engine -------------------------------------------------------------
# Absolute path to the gost-engine .so. Required when the OpenSSL signature
# allow-list contains GOST: implicit OPENSSL_ENGINES lookup is rejected.
# The file and every ancestor must be root-owned and non-group/world-writable.
# Only meaningful with crypto_backend = "openssl".
# gost_engine_path = "/usr/lib/x86_64-linux-gnu/engines-1.1/gost.so"

# --- USB monitor -------------------------------------------------------------
# Maximum time to block waiting for the user's USB token at auth time.
# Range 0..=300; 0 means fail-fast (no wait).
usb_wait_seconds = 10
# Allow-list of USB devices considered as the PKCS#12 medium, as "vid:pid"
# hex strings in lsusb format (four hex digits each). Empty or absent = any
# USB block device. Hygiene against stray sticks, NOT a trust boundary:
# VID/PID are spoofable; trust comes from .p12 decryption + chain validation.
# usb_allowed_devices = ["0951:1666"]
# Максимальное число USB-партиций, перебираемых при поиске .p12.
# Защита от DoS: атакующий с физическим доступом не сможет заставить
# модуль mount/unmount слишком много FS подряд. Range 1..=64.
max_usb_partitions = 8
# Action to take after a confirmed USB removal. One of:
#   "lock"    — lock the user's session via logind.
#   "logout"  — terminate the user's session via logind.
#   "hook"    — invoke the configured `usb_removed` hook(s).
#   "shutdown" — power off the host.
on_usb_removed = "lock"
# Grace window between a USB removal event and the configured action.
# A reinsertion of the same serial within this window cancels the action.
usb_removed_grace_seconds = 5
# After a system resume from sleep, ignore USB-removal events for this many
# seconds (suspend transients on some hubs raise spurious removals).
suspend_grace_seconds = 30
# Daemon-failure handling for the PAM module.
#   "strict"     — any daemon I/O / timeout error fails auth.
#   "permissive" — transient I/O errors are tolerated; typed failures
#                  (DeviceGone / Unauthorized) always propagate.
# PKCS#11 token-removal events are not observable by monitord yet, so strict
# continuous-presence auth is refused for mode = "pkcs11". Use permissive
# until a native token-event source is configured.
monitor_fail_mode = "permissive"

# --- Monitor (PAM client + tessera daemon) -----------------------------
# Both pam_tessera.so AND tessera read this section. Any field
# left unset falls back to the legacy top-level option above (where one
# exists) or to the documented default.
[monitor]
# Path to the monitor daemon Unix socket. Default
# `/run/tessera/monitord.sock` (filename is kept for ABI compatibility).
# socket_path = "/run/tessera/monitord.sock"
# Per-RPC connect+IO timeout (PAM client side), in milliseconds. Default 2000.
# timeout_ms = 2000
# Per-section fail-mode override. When unset, falls back to the top-level
# `monitor_fail_mode` above. One of "strict" | "permissive" | "degraded".
# fail_mode = "strict"
# Path to the session-registry JSON written by the daemon. Default
# `/run/tessera/sessions.json` (tmpfs, volatile across reboot — the
# registry only needs to survive daemon restart within a boot).
# state_file_path = "/run/tessera/sessions.json"
# Action the daemon takes after a confirmed USB removal past the grace
# window. One of "lock" | "logout" | "shutdown" | "hook". Default "lock".
# When unset, falls back to the top-level `on_usb_removed`.
# on_usb_removed = "lock"
# Grace window between a USB removal event and the configured action.
# Default 5. Falls back to the top-level `usb_removed_grace_seconds`.
# usb_removed_grace_seconds = 5
# Suspend-grace window: removals within this many seconds after a resume
# are ignored. Default 30. Falls back to top-level `suspend_grace_seconds`.
# suspend_grace_seconds = 30
# Required ONLY when `on_usb_removed = "hook"`: absolute path to the hook
# executable invoked on USB removal. Validator rejects "hook" without it.
# on_usb_removed_hook_path = "/usr/local/sbin/usb-removed-hook"
# IPC server hardening (P1-F).
#   idle_timeout_seconds       — max silence between client messages
#                                before the server closes the connection.
#                                Default 30.
#   max_concurrent_connections — accept-loop semaphore cap. Default 64.
# idle_timeout_seconds = 30
# max_concurrent_connections = 64

# --- Cert binding ------------------------------------------------------------
# The host ACL is gone. Authorisation ("which account on which device") is
# encoded in two X.509 extensions on each end-entity certificate:
#   - 2.25.183976554325829274683049824615098        (pam_cert_host_binding)
#   - 2.25.185305973969816596290730578528098241367  (pam_cert_allowed_roles)
# Each is a SEQUENCE OF UTF8String. The certificate alone decides which
# devices it is valid on and which accounts it admits — a login account name
# IS a role name, so the role list answers the second question. There is no
# device-side list that admits a certificate by its CN or SAN. See
# docs/cert-issuance.md for the openssl.cnf cookbook used at issuance time.

# --- Trust -------------------------------------------------------------------
[trust]
# PEM-encoded trust anchors (root CAs). At least one entry required.
anchors = [
    "/etc/tessera/ca/bundle.pem",
]
# Optional intermediates. PEM-encoded.
intermediates = []
# Maximum chain depth (1..=10 typical; must be > 0).
max_chain_depth = 5
# Tolerated clock skew when checking notBefore/notAfter, in seconds. Hard
# upper bound is 600.
clock_skew_seconds = 60
# Allowed signature OIDs / friendly names. An empty (or omitted) list falls
# back to a safe default set: sha256/384/512WithRSAEncryption and
# ecdsa-with-SHA256/384/512 — no SHA-1, no GOST (GOST requires explicit opt-in).
# When set, each entry is matched **exactly** against the certificate's
# OpenSSL display form (substring matching was removed in 1.0.1, P1-C).
# Examples:
#   "sha256WithRSAEncryption"
#   "ecdsa-with-SHA384"
#   "id-tc26-signwithdigest-gost3410-12-256"
#   "id-tc26-signwithdigest-gost3410-12-512"
allowed_signature_algorithms = []
# Highest certificate-format version (`pam_cert_profile_version`) this Engine
# understands. A certificate at any link of the chain declaring a higher
# version rejects the whole chain (fail-closed version gate); an absent
# extension counts as version 0. Omit the key to keep the compiled-in default
# shown below, which is also the version `issuer` mints by default. Raise it
# only after the whole fleet runs a build that understands the newer format.
# max_supported_profile_version = 0

# --- Trust → revocation ------------------------------------------------------
[trust.revocation]
# REQUIRED. "none" | "crl" | "ocsp" | "crl_then_ocsp". Omitting this section
# or the `mode` key is a validation error — there is no silent default, so a
# revoked certificate can never authenticate by oversight. "none" disables
# revocation checking and must be chosen deliberately. OCSP modes require
# ocsp_responder_url; optional knobs: ocsp_timeout_seconds,
# ocsp_cache_ttl_seconds. Zero-egress fleets stay on "none" (short-TTL
# discipline) or offline "crl".
mode = "none"
# ocsp_responder_url = "http://ocsp.example.org"
# ocsp_timeout_seconds = 5
# ocsp_cache_ttl_seconds = 3600
# CRL files (PEM/DER). Required when mode = "crl".
crl_paths = []
# Maximum accepted CRL age in hours, measured from thisUpdate (1..=8760).
# A CRL older than this is stale even if its nextUpdate is in the future
# (or missing). Omit to disable the cap; a CRL with no nextUpdate is then
# logged as having unverifiable freshness.
# crl_max_age_hours = 24

# --- Trust → pinning ---------------------------------------------------------
[trust.pinning]
# When enabled, only chains anchored by one of the listed SPKI hashes pass.
enabled = false
# Lower-case hex SHA-256 of trust-anchor SubjectPublicKeyInfo (64 chars each).
allowed_root_spki_sha256 = []

# --- Trust overrides (optional) ---------------------------------------------
# Per-host override of trust anchors. Each entry must list at least one host
# id and at least one replacement anchor; intermediates are optional.
# [[trust_override]]
# when_host_id_in = ["ws-001.example.org"]
# anchors         = ["/etc/tessera/ca/site-foo.pem"]

# --- Host identity -----------------------------------------------------------
[host_identity]
# Order matters: the first source that yields a non-empty value wins.
# Allowed: "machine_id", "dmi_board_serial", "dmi_system_uuid",
#          "dmi_system_serial", "hostname", "custom_command", "override".
sources = ["machine_id", "hostname"]
# What to do when every source fails: "deny" | "warn" | "allow".
fallback = "deny"
# Optional explicit override (used mainly for testing).
# override = "ws-test-001"
# Optional path to a custom-command script that prints the host id on stdout.
# custom_command = "/usr/local/sbin/host-id"
# Bound on how long the custom command may take. Clamped to 1..=30 seconds.
custom_command_timeout_seconds = 5

# --- Roles -------------------------------------------------------------------
# The role at login is the login account name: the engineer logs into a role
# account named after the role (`ssh serv@device`) and the requested role
# equals PAM_USER. A role is required at EVERY login; there is no key that
# disables the check or weakens it to a warning.
#
# The role definition is read from the on-device role store: one <role>.toml
# slice per role. The store MUST be populated — an empty or unreadable store
# denies every login fail-closed. Trust in the store rests on filesystem
# permissions (the sudoers.d model): the directory, every slice and every
# parent must be root-owned and not group/world-writable.
[roles]
# On-device role-store directory. Absolute path. Default:
dir = "/var/lib/tessera/roles"
# Session TTL used when neither the credential nor the role slice sets one.
# Seconds, must be > 0; a session cap is never unbounded. Default 43200 (12h).
# default_session_ttl_seconds = 43200
# How long name resolution may take while the login account is checked against
# the system accounts. That check runs before any credential is presented, so
# an unresponsive directory (LDAP/sssd) would otherwise delay every login
# attempt, the emergency console one included. Running the limit out counts as
# silence — the local /etc/passwd verdict stands and the login continues — and
# the resolver is then not asked again for the life of the process.
# Seconds, 1..=60; 0 is rejected, because a disabled check would let a systemd
# DynamicUser account (no entry in /etc/passwd) log in. Default 10.
# account_lookup_timeout_seconds = 10

# --- Logging -----------------------------------------------------------------
[logging]
# error | warn | info | debug | trace.  Applied by the daemon's tracing
# filter once the config is loaded; the TESSERA_LOG environment variable
# takes precedence over this value.
level = "info"
# Deprecated keys (accepted but ignored, WARN at load time):
#   syslog_facility   — the PAM module always logs to the `auth` facility,
#                       the daemon writes to stderr → journald.
#   journald_priority — never applied.

# --- Hooks -------------------------------------------------------------------
# Each hook is invoked with placeholders ${pam_user}, ${cert_cn},
# ${cert_serial}, ${host_id}, etc. expanded at call time. Always run as
# root; drop privileges via `run_as` if available.
# Stages: "pre_auth" | "post_auth_success"
#         "session_open" | "session_close" | "usb_removed"

# [[hooks]]
# stage           = "post_auth_success"
# command         = ["/usr/local/sbin/log-auth", "${pam_user}"]
# timeout_seconds = 10
# env             = { PAM_USER = "${pam_user}", CERT_CN = "${cert_cn}" }

# [[hooks]]
# stage           = "usb_removed"
# command         = ["/usr/local/sbin/lock-screen"]
# timeout_seconds = 5

# ------------------------------------------------------------------
# [fly_dm_greeter] — fly-dm login-screen wallpaper banner
# ------------------------------------------------------------------
# On Astra МКЦ-3 (production terminal) fly-modern theme hardcoded'но
# подставляет в headline place "Усиленный уровень защищенности"
# из fly-dm_greet_modern.mo; GreetString игнорируется. Единственный
# надёжный канал показать host_id оператору — впечатать его в
# JPG-фон, на который указывает settings.ini [background].path.
#
# When update_wallpaper = true, tessera on each daemon start:
#   1. cp wallpaper_target → wallpaper_backup (one-time)
#   2. open wallpaper_backup as source
#   3. render text overlay (template_ru / template_en по locale)
#   4. atomic write → wallpaper_target
#
# tessera НЕ редактирует /etc/X11/fly-dm/fly-modern/settings.ini.
# Operator/ansible управляет blur=false, color_overlay alpha,
# и (если нужно) указывает кастомный path. Default Astra path:
# /usr/share/wallpapers/fly-default-light.jpg.
#
# Templates support placeholders:
#   {host_id_short}  - 8-char SHA-256 hex prefix of host_id
#   {source}         - snake_case source kind (e.g. dmi_board_serial)
#   %n               - local hostname (substituted by tessera)
#
# Opt-in: default false.

[fly_dm_greeter]
update_wallpaper = false
# wallpaper_target     = "/usr/share/wallpapers/fly-default-light.jpg"
# wallpaper_backup     = "/var/lib/tessera/daemon/wallpaper.orig.jpg"
# wallpaper_font       = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
# wallpaper_font_size  = 64
# wallpaper_text_color = "#000000"
# wallpaper_gravity    = "south"   # north | south | east | west | center
# wallpaper_offset_x   = 0
# wallpaper_offset_y   = 120
# template_ru          = "Устройство %n  host_id={host_id_short} ({source})"
# template_en          = "Device %n  host_id={host_id_short} ({source})"

# --- Code login (telephone channel) ------------------------------------------
# The device prints a challenge, the engineer reads it to an operator over the
# telephone, the operator computes a code in their cabinet and reads it back,
# the device verifies it locally. No network, no site, no trusted clock — which
# is the point: this is the method for the device nobody can reach any other
# way.
#
# The artefacts the method needs (the device key container, the operator ticket
# set, its revocation list and the ticket anchor) are NOT configured here. They
# are delivered by the enrolment package or a courier payload and land in `dir`:
#
#   tessera enroll --standalone --import /mnt/usb/pkg --codes-pin-file /run/pin
#
# The PIN of the delivery container is supplied to that command and to nothing
# else: it protects the container while it travels. After the import the key is
# stored without one, because the device has to come back from a power cut on
# its own, with nobody in the room to type anything, and what guards it there is
# the ownership and mode of the store — dir `0700`, key `0600`, root — which the
# method verifies before it offers itself. `[codes].key_password` existed for a
# while and has been REMOVED: a password kept beside the container it opens
# protects nothing from anyone the file permissions admit already, and a config
# still naming it is rejected at load with an explanation.
[codes]
# Whether this device offers the method. Default false — a fleet that has not
# provisioned the artefacts has not configured a method, and silence is not an
# opt-in.
#
# Switching this on also switches on the hash-chained journal below: a code
# login is provable after the fact only if it was written down, so `[audit]`
# follows this flag whenever it does not state `enabled` itself. Writing that
# key explicitly overrides the coupling in either direction.
enabled = false
# Where the artefacts and the nonce state live. Absolute path. Default:
# dir = "/var/lib/tessera/codes"
# Number of THIS device including its check character, exactly as printed on
# the device label and read aloud. Required when enabled.
# device_number = "77-000123S"
# Key epoch of this device. Required when enabled. It is a declaration, not the
# authority: the number written beside the key at import wins, and a
# configuration naming an epoch the store does not hold refuses the method
# rather than deriving codes nobody can match.
# epoch = 1
# Region and tags of this device, matched against the scope of an operator
# ticket. Required when enabled; a device carrying no tag is reached by no
# ticket, so an empty list is rejected rather than silently refusing every code.
# region = "ru-central"
# tags = ["dc-1", "hq"]
# Lifetime of an attempt, in seconds. Fleet parameter, not part of the agreed
# code, and bounded at both ends by the contract: it may not be zero and may not
# exceed 600. Without an upper bound "only stricter" would bound nothing upward,
# and the window a status answer stands for would stretch with the attempt.
# Default 300.
# code_ttl_seconds = 300
# Parameters BOTH sides must agree on. They are fleet-wide: a device and the
# side computing its codes have to carry the same values, and a device may only
# be stricter than the contract, never weaker. Defaults shown.
#
# The contract bounds the CODE by strength rather than by length: at least
# twenty bits of guesswork, which is where ten attempts against a million values
# leave less than one chance in a hundred thousand. Six characters of Crockford
# base32 carry thirty bits and are the default; a fleet that chooses the decimal
# alphabet has to raise the length with it — SEVEN digits is the shortest that
# clears the floor, six carry 19.9 bits and are refused when the file is loaded.
# The same rule applies to the nonce, with its own floor of a hundred and
# twenty-eight bits: twenty-six base32 characters, or thirty-nine decimal ones.
# code_len = 6
# attempts_per_nonce = 5
# alphabet = "crockford-base32"   # crockford-base32 | decimal
# nonce_width = 26
#
# The same fleet on the decimal alphabet:
# code_len = 7
# alphabet = "decimal"
# nonce_width = 39
# Key agreement of the device pairs. The only value this device can actually
# perform today is "p256", and naming any other is refused when the file is
# loaded rather than at the keyboard: a configuration that loads says the method
# works, and a code that cannot be verified is reported exactly like a wrong one.
# profile = "p256"
#
# The contract of the channel also defines "x25519" and "gost-vko-34.10-2012",
# and the operator cabinet computes against them — the device half is not
# written yet, so a fleet cannot run on them. The GOST profile additionally
# carries an open vendor gate (its key agreement has not been exercised on a
# Linux build of the vendor PKCS#11 library), which is what
# `accept_unconfirmed_profile` below is about.
# Whether the fleet owner accepted a key-agreement profile whose vendor gate is
# still open. Default false — an unconfirmed profile does not validate, and
# silence is not consent.
# accept_unconfirmed_profile = false

# --- Audit journal -----------------------------------------------------------
# The device's own journal, hash-chained: each record carries the hash of the
# previous one, so a record removed later leaves a mark instead of a gap nobody
# can see.
#
# It switches itself on together with the code login method, and that coupling
# is not a convenience. Control over the operator of the telephone channel
# rests on reconciling the logins a device saw against the receipts its
# operators wrote, and this journal is what makes that reconciliation possible.
# A device offering the method without a journal is broken in a way it cannot
# discover about itself: every login looks fine locally and nothing can be
# paired afterwards. Stating `enabled` here decides it outright, in either
# direction.
[audit]
# enabled = true
# Where the chain lives. Default:
# file = "/var/lib/tessera/audit.ndjson"
# Size the chain may reach, in bytes. Default 67108864 (64 MiB).
# ceiling_bytes = 67108864
# What happens at the ceiling: refuse | rotate.
#   refuse — new records are refused, and everything whose record is
#            load-bearing stops with them. The default, because a journal that
#            silently drops what it cannot fit is not a journal.
#   rotate — start a new chain, leaving a record of the break in it, so the
#            discontinuity is visible rather than inferred from a gap.
# when_full = "refuse"
# How often the head of the chain is attested on a schedule, in seconds.
# Default 86400 (a day).
# attest_interval_seconds = 86400
