[Unit]
Description=Tessera USB-token monitor daemon
Documentation=file:///usr/share/doc/tessera/README.md.gz
Documentation=man:tessera(8)
After=systemd-udevd.service systemd-logind.service dbus.service
Wants=systemd-tmpfiles-setup.service
Requires=systemd-logind.service

[Service]
Type=notify
# Batch 4 (P1-D): the daemon reads its operational knobs from the SAME shared
# config the PAM cdylib parses, so operators only edit one file. Keep CLI
# flags in mind only as on-the-fly overrides for staging / debugging.
ExecStart=/usr/bin/tessera daemon --config /etc/tessera/config.toml
Restart=on-failure
RestartSec=5s
# A PKCS#11 call blocked inside the provider cannot be cancelled from within
# the daemon: the thread stays in the vendor library, and with it the only
# view the daemon has of whether a token carrier is still present. The daemon
# withholds the WATCHDOG=1 keepalive while its presence poll is not returning,
# so systemd replaces the process — and the first poll after the restart
# re-establishes presence from scratch. Hosts whose carrier is a USB medium
# run no poll and are fed unconditionally.
#
# How long the daemon may stay blind after a poll stalls is the sum of four
# terms, not one:
#
#   2 x (token_poll_interval_seconds + 5s call timeout)  before the daemon
#                                                        judges the poll stalled
# + WatchdogSec                                          before systemd acts on
#                                                        the withheld keepalive
# + RestartSec                                           before the new process
# + one poll cycle                                       before its first poll
#                                                        returns
#
# The last term is not a wait for the interval to elapse: the new process
# polls before its first sleep, so what is counted there is the poll itself.
#
# With the shipped defaults (2s interval, 45s here, 5s RestartSec) that is
# 14 + 45 + 5 + 2 = 66 seconds. Raising WatchdogSec widens the window one for
# one. The first two terms are what the daemon controls; the stall threshold is
# derived from the poll cadence rather than from this value, so a deliberately
# slow poll interval cannot turn into a restart loop.
#
# Under monitor.fail_mode = "strict" the daemon refuses to start when this is
# absent: strict promises continuous presence, and without a way to recover
# from a stalled poll that promise outlives the first stall.
WatchdogSec=45s
# Run as a dedicated system user (created by postinst). The daemon does
# NOT need root: mount(2) is performed by pam_tessera.so inside the PAM
# caller's context; the daemon's privileged actions (LockSession /
# TerminateSession / PowerOff on logind) are gated by a polkit rule
# shipped at /usr/share/polkit-1/rules.d/49-tessera.rules that
# allows the `tessera` user to invoke those D-Bus methods.
User=tessera
Group=tessera
RuntimeDirectory=tessera
RuntimeDirectoryMode=0750
# Keep /var/lib/tessera itself root-owned: it contains trusted roles, tags,
# CRLs, and enrollment state. Only this daemon-specific leaf is writable by
# the unprivileged service account.
StateDirectory=tessera/daemon
StateDirectoryMode=0750
CacheDirectory=tessera
CacheDirectoryMode=0750
ProtectSystem=strict
ReadWritePaths=/run/tessera /var/cache/tessera /var/lib/tessera/daemon
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# MemoryDenyWriteExecute is left off because OpenSSL/gost-engine may need W^X
# relaxation for ASN.1 parser JIT in libcrypto. Stage 8 should benchmark with
# =yes and flip if no measurable regression.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
