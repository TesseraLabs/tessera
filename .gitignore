/target
**/*.rs.bk
Cargo.lock.bak
.idea/
.vscode/
*.swp
.DS_Store
/coverage/

# Release artifacts (built locally; signed/published from release runners).
/artifacts/release/

# GOST test fixtures — regenerated via tests/fixtures/gen_gost.sh on
# Linux+gost-engine.  Not committed because they cannot be produced on macOS
# dev hosts (no engine available).  The directory itself is preserved by the
# committed `.keep` placeholder.
crates/tessera_core/tests/fixtures/gost/*
!crates/tessera_core/tests/fixtures/gost/.keep
.claude/scheduled_tasks.lock

# Не для публичного репозитория (open-core split, design D6):
# клиентский контекст, боевые логи, продуктовая стратегия.
openspec/.bootstrap-notes/
docs/PRODUCT_SPEC.md

# Осиротевший сломанный worktree (кандидат на удаление).
CertAuth-scopes-mofn/

# Local working notes — not for the repo
docs/superpowers/plans/
notes/bootstrap-notes/
/target-linux/

# Local E2E scratch (issuer cabinet run)
/e2e-tmp/

# Локальный CARGO_HOME сборки пакета (debian/rules): сотни мегабайт исходников
# зависимостей, которые иначе уезжают в коммит при `git add -A`.
/debian/cargo_home/

# Выхлоп debhelper: staged-дерево пакета и служебные отметки сборки. Опасны не
# размером, а тем, что это СНИМОК кода на момент последней локальной сборки —
# собранный модуль и пример конфига из него переживают правку исходников и
# уезжают в коммит с чужой, уже неверной реализацией.
/debian/tessera/
/debian/.debhelper/
/debian/files
/debian/debhelper-build-stamp
/debian/*.substvars
/debian/*.debhelper
/debian/*.debhelper.log

# Результаты прогонов e2e-реестра: артефакты конкретного стенда и машины.
# Регрессия хранится в tests/e2e/BASELINE.md, он под контролем версий.
/tests/e2e/runs/
