# Образец ~/.config/tessera-e2e/stand.toml — параметров конкретного стенда.
#
# Файл живёт ВНЕ git: в нём адреса лабораторных машин, учётные записи и ссылки
# на секреты. Профили в репозитории описывают только тип окружения и возможности,
# всё остальное — здесь.
#
# Пароли и PIN-коды задаются ССЫЛКАМИ op:// и никогда — значениями. Раннер
# разрешает их через `op read` один раз на старте прогона, до первого кейса:
# значения живут только в памяти, на диск не пишутся и в отчёты не попадают.
# Ленивое разрешение в момент шага недопустимо — недоступность хранилища
# выглядела бы как провал аутентификации, а не как проблема стенда.
#
# Скопировать: cp tests/e2e/profiles/stand.toml.example ~/.config/tessera-e2e/stand.toml
# (при заданном XDG_CONFIG_HOME — в $XDG_CONFIG_HOME/tessera-e2e/stand.toml)

# ---------------------------------------------------------------------------
# Проверяемый пакет
# ---------------------------------------------------------------------------
# Проверяется артефакт штатного пайплайна; сборка внутри прогона не выполняется.
[package]
deb = "/Users/me/Downloads/tessera_0.4.0_amd64.deb"

# Происхождение пакета: локальный путь, «локальная сборка» или идентификатор
# прогона build.yml, из которого артефакт скачан.
source = "локальная сборка"

# Коммит, из которого собран артефакт. Заполнять ТОЛЬКО если его есть чем
# подтвердить: коммит рабочего дерева сюда не годится — версия пакета не
# уникальна по коммиту, и прогон иначе припишет успех непроверенному коду.
# Без этого поля прогон помечается как проведённый с неустановленным
# провенансом и на роль релизного evidence не годится.
# commit = "0000000000000000000000000000000000000000"

# ---------------------------------------------------------------------------
# Что везётся в окружение помимо пакета
# ---------------------------------------------------------------------------
# Секция необязательная: стенду, которому хватает пакета и фикстур, она не нужна.
#
# Сюда попадает то, чего нет ни в .deb, ни в репозитории: собранные отдельным
# релизным пайплайном бинари. Путь к такому файлу у каждого стенда свой, поэтому
# профиль в git его знать не может, а место сборки — не сборочный контекст образа.
# Пример: кейсы 60-issuer требуют внутри окружения бинарь issuer.
#
# Источник проверяется ДО пересоздания окружения и первого кейса: отсутствующий
# файл — ошибка описания стенда, а не провал продукта. Доставленное приводится к
# root:root, как и всё остальное; mode задаёт права на файл (по умолчанию 0644),
# и без бита исполнения бинарь провалил бы кейсы так, будто сломан продукт.
#
# Всё доставленное попадает в отчёт вместе с контрольной суммой: прогон, в
# котором рядом с продуктом работал бинарь неизвестного происхождения, чистым
# не считается.
#
# [[artifacts]]
# path = "/Users/me/Projects/tessera/target/release/issuer"
# target = "/usr/local/bin/issuer"
# mode = "0755"

# ---------------------------------------------------------------------------
# Подстановки, доступные кейсам как {{...}}
# ---------------------------------------------------------------------------
# Значения перекрывают одноимённые переменные профиля: лаборатория знает лучше.
[vars]
# Учётная запись, от имени которой проверяется вход. Удостоверения фикстур
# выписаны на CN=alice, поэтому и запись называется так же: иначе account-фаза
# откажет по причине, не имеющей отношения к проверяемой гарантии.
# Подготовка (deploy-fixtures.sh) заводит её в окружении сама.
user = "alice"

# Каталог с фикстурами внутри окружения. В контейнерных профилях он уже задан
# профилем — переопределять нужно только на машине с другой раскладкой.
# fixtures = "/opt/tessera-e2e/fixtures"

# PIN контейнера удостоверения. ТОЛЬКО ссылка, не значение.
pin = "op://Development/Tessera E2E/pin"

# Пароль sudo на VM, если он нужен кейсам enforcement. Тоже только ссылкой.
# sudo_password = "op://Development/Tessera E2E/sudo"

# ---------------------------------------------------------------------------
# Машины для ssh-профилей
# ---------------------------------------------------------------------------
# Имя таблицы совпадает с полем `host` секции [ssh] профиля. Контейнерным
# профилям хосты не нужны: окружение создаётся с нуля флагом --recreate.
#
# ControlMaster намеренно не включается: Astra ограничивает число одновременных
# сессий, поэтому раннер открывает соединение на шаг.
[hosts.astra-vm]
address = "192.168.2.139"
port = 22
user = "robonet"
identity_file = "~/.ssh/tessera-lab"
# ssh_options = ["StrictHostKeyChecking=accept-new"]

# Напоминание про teardown этого профиля: PAM-стеки принадлежат живой системе,
# поэтому внесённые изменения снимаются через integrate-pam.sh --unintegrate
# ДО удаления пакета. Полагаться на postrm нельзя — он снимает только строку
# @include tessera*, оставляя session required pam_tessera.so ссылаться на
# удалённый модуль, после чего перестают работать sudo и вход в систему.
